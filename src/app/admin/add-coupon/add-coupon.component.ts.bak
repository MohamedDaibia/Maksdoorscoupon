import { HttpClient, HttpErrorResponse } from '@angular/common/http';
import { Component, DestroyRef, OnInit, computed, inject, signal } from '@angular/core';
import { FormControl, ReactiveFormsModule, Validators } from '@angular/forms';
import { RouterLink } from '@angular/router';
import { HubConnection, HubConnectionBuilder, LogLevel } from '@microsoft/signalr';
import { API_URL } from '../../api.config';
import { CouponService } from '../../coupon/coupon.service';
import { AdminAuthService } from '../admin-auth.service';

/** How many coupons the "Generate 100 coupon" button creates. */
const BULK_COUNT = 100;

@Component({
  selector: 'app-add-coupon',
  imports: [ReactiveFormsModule, RouterLink],
  styleUrl: '../admin-pages.css',
  template: `
    <div class="head">
      <h1>Add Coupon</h1>
      <p class="total-line">Total coupon generated: <strong>{{ total() }}</strong></p>
    </div>

    <form class="panel" (submit)="$event.preventDefault(); onSubmit()" novalidate>
      <p class="subtitle" style="margin-top: 0">Create a coupon number that carpenters can redeem.</p>

      @if (addedCode()) {
        <div class="success" role="status">
          Coupon {{ addedCode() }} added. <a routerLink="/admin/coupons">View all coupons</a>
        </div>
      }

      <div class="field">
        <label for="code">Coupon number</label>
        <div class="input-row">
          <input id="code" class="text" type="text" [formControl]="code" placeholder="e.g. MAKS-1004"
                 autocomplete="off" autocapitalize="characters" spellcheck="false" />
          <button type="button" class="ghost" (click)="generate()">Generate</button>
        </div>
        <button type="button" class="bulk-btn" [disabled]="bulkRunning()" (click)="generateBulk()">
          {{ bulkRunning() ? 'Generating…' : 'Generate ' + bulkCount + ' coupon' }}
        </button>
        @if (bulkRunning() || bulkDone() > 0 || bulkError()) {
          <div class="bulk">
            <div class="bar" role="progressbar" aria-label="Generating coupons" aria-valuemin="0"
                 [attr.aria-valuemax]="bulkTotal()" [attr.aria-valuenow]="bulkDone()">
              <div class="bar-fill" [style.width.%]="bulkPercent()"></div>
            </div>
            <span class="bulk-text">{{ bulkDone() }} of {{ bulkTotal() }} coupons ({{ bulkPercent() }}%)</span>
          </div>
        }
        @if (bulkMessage()) { <span class="bulk-ok" role="status">{{ bulkMessage() }} <a routerLink="/admin/coupons">View all coupons</a></span> }
        @if (bulkError()) { <span class="error" role="alert">{{ bulkError() }}</span> }
        @if (error()) {
          <span class="error" role="alert">{{ error() }}</span>
        } @else if (code.invalid && code.touched) {
          <span class="error">Use 4 to 20 letters, numbers or hyphens.</span>
        }
      </div>

      <div class="field">
        <label>Value</label>
        <div class="readonly">₹{{ value }}</div>
      </div>

      <div class="form-actions">
        <button type="submit" class="cta" [disabled]="busy()">{{ busy() ? 'Saving…' : 'Add coupon' }}</button>
        <a class="cancel" routerLink="/admin/coupons">Cancel</a>
      </div>
    </form>
  `,
})
export class AddCouponComponent implements OnInit {
  private readonly coupons = inject(CouponService);

  readonly value = CouponService.COUPON_VALUE;
  /** How many coupons are saved in the database. Updates as soon as one is added. */
  readonly total = computed(() => this.coupons.dbTotal());
  readonly busy = signal(false);

  // ---- Generate 100 coupons (progress comes live over SignalR) ----
  readonly bulkCount = BULK_COUNT;
  readonly bulkRunning = signal(false);
  readonly bulkDone = signal(0);
  readonly bulkTotal = signal(BULK_COUNT);
  readonly bulkError = signal('');
  readonly bulkMessage = signal('');
  readonly bulkPercent = computed(() =>
    this.bulkTotal() ? Math.round((this.bulkDone() / this.bulkTotal()) * 100) : 0,
  );
  private readonly http = inject(HttpClient);
  private readonly adminAuth = inject(AdminAuthService);
  private connection: HubConnection | null = null;
  readonly code = new FormControl('', {
    nonNullable: true,
    validators: [Validators.required, Validators.pattern(/^[A-Za-z0-9-]{4,20}$/)],
  });
  readonly error = signal('');
  readonly addedCode = signal('');

  ngOnInit(): void {
    this.coupons.loadAdminCoupons();
  }

  constructor() {
    inject(DestroyRef).onDestroy(() => void this.connection?.stop());

    this.code.valueChanges.subscribe(() => {
      this.error.set('');
      this.addedCode.set('');
    });
  }

  /** Opens a live connection, then asks the server to create the coupons and shows its progress. */
  async generateBulk(): Promise<void> {
    if (this.bulkRunning()) {
      return;
    }
    this.bulkError.set('');
    this.bulkMessage.set('');
    this.bulkDone.set(0);
    this.bulkTotal.set(BULK_COUNT);
    this.bulkRunning.set(true);

    try {
      const connection = new HubConnectionBuilder()
        // The hub lives next to the API, not under /api.
        .withUrl(`${API_URL.replace(/\/api\/?$/, '')}/hubs/coupons`, {
          accessTokenFactory: () => this.adminAuth.token() ?? '',
        })
        .configureLogging(LogLevel.Warning)
        .build();
      this.connection = connection;

      connection.on('GenerationProgress', (p: { done: number; total: number }) => {
        this.bulkDone.set(p.done);
        this.bulkTotal.set(p.total);
      });
      connection.on('GenerationCompleted', (r: { created: number }) => {
        this.bulkDone.set(r.created);
        this.bulkMessage.set(`${r.created} new coupons created.`);
        this.finishBulk();
        this.coupons.loadAdminCoupons(1);
      });
      connection.on('GenerationFailed', (r: { error: string }) => {
        this.bulkError.set(r.error);
        this.finishBulk();
      });
      connection.onclose(() => {
        if (this.bulkRunning()) {
          this.bulkError.set('Lost the live connection. Check the coupon list to see how many were created.');
          this.bulkRunning.set(false);
        }
      });

      await connection.start();
      this.http
        .post(`${API_URL}/admin/coupons/generate`, { count: BULK_COUNT, connectionId: connection.connectionId })
        .subscribe({
          error: (err: HttpErrorResponse) => {
            this.bulkError.set(
              err.status === 0
                ? 'Cannot reach the server. Please check that the API is running.'
                : ((err.error as { error?: string } | null)?.error ?? 'Could not start generating coupons.'),
            );
            this.finishBulk();
          },
        });
    } catch {
      this.bulkError.set('Could not open the live connection. Please check that the API is running.');
      this.finishBulk();
    }
  }

  private finishBulk(): void {
    this.bulkRunning.set(false);
    const connection = this.connection;
    this.connection = null;
    void connection?.stop();
  }

  /** Makes a random number like MAKS-7H2K9Q (no look-alike letters or digits). */
  generate(): void {
    const alphabet = 'ABCDEFGHJKLMNPQRSTUVWXYZ23456789';
    const bytes = crypto.getRandomValues(new Uint8Array(6));
    const suffix = Array.from(bytes, (b) => alphabet[b % alphabet.length]).join('');
    this.code.setValue(`MAKS-${suffix}`);
  }

  onSubmit(): void {
    if (this.code.invalid) {
      this.code.markAsTouched();
      return;
    }
    if (this.busy()) {
      return;
    }
    this.busy.set(true);
    this.coupons.addCoupon(this.code.value).subscribe((result) => {
      this.busy.set(false);
      if (result.ok) {
        this.code.reset('', { emitEvent: false });
        this.code.markAsUntouched();
        this.error.set('');
        this.addedCode.set(result.code);
      } else {
        this.error.set(result.reason);
      }
    });
  }
}
