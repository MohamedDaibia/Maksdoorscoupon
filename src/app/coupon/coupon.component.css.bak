:host { display: block; }
* { box-sizing: border-box; }

.page {
  min-height: 100vh;
  display: flex;
  flex-direction: column;
  font-family: 'Segoe UI', Roboto, Helvetica, Arial, sans-serif;
  background:
    radial-gradient(900px 400px at 50% -80px, rgba(200, 128, 58, .18), transparent 70%),
    #faf7f2;
  color: #3b2a1a;
}

/* ---------- Main ---------- */
.main {
  flex: 1; width: 100%; max-width: 560px; margin: 0 auto;
  padding: 56px 24px 140px; text-align: center;
}
h1 { margin: 0; font-size: 32px; }
.subtitle { margin: 8px 0 32px; color: #7a6a5a; }

.banner {
  margin-bottom: 20px; padding: 14px 16px; border-radius: 12px; font-weight: 600;
}
.banner.success { background: #e8f5ea; color: #1f6a30; }

.coupon-input {
  width: 100%; padding: 26px 20px;
  border: 2px solid #dccfbf; border-radius: 18px; background: #fff; color: #2a1d12;
  font-size: 28px; font-weight: 600; text-align: center; letter-spacing: 3px;
  text-transform: uppercase; outline: none;
  box-shadow: 0 8px 24px rgba(90, 52, 22, .08);
  transition: border-color .2s, box-shadow .2s;
}
.coupon-input::placeholder {
  color: #b9a995; font-weight: 500; letter-spacing: 0; text-transform: none; font-size: 24px;
}
.coupon-input:focus { border-color: #b9722d; box-shadow: 0 0 0 4px rgba(185, 114, 45, .18); }
.coupon-input.is-valid { border-color: #2e9d4a; box-shadow: 0 0 0 4px rgba(46, 157, 74, .15); }
.coupon-input.is-invalid { border-color: #d64545; box-shadow: 0 0 0 4px rgba(214, 69, 69, .13); }

.status { min-height: 28px; margin-top: 16px; font-size: 15px; font-weight: 600; }
.status .ok { color: #1f8a3b; }
.status .bad { color: #d64545; }
.status .checking { color: #7a6a5a; display: inline-flex; align-items: center; gap: 8px; }
.spinner {
  width: 14px; height: 14px; border-radius: 50%;
  border: 2px solid #dccfbf; border-top-color: #b9722d;
  animation: spin .7s linear infinite;
}
@keyframes spin { to { transform: rotate(360deg); } }

/* ---------- Bottom bar ---------- */
.bottombar {
  position: fixed; left: 0; right: 0; bottom: 0; z-index: 5;
  padding: 16px 24px calc(16px + env(safe-area-inset-bottom));
  background: rgba(250, 247, 242, .94); backdrop-filter: blur(8px);
  border-top: 1px solid #eadfce;
  display: flex; justify-content: center;
}
.claim {
  width: 100%; max-width: 560px; padding: 17px; border: none; border-radius: 14px;
  background: linear-gradient(135deg, #c8803a, #8a4b14); color: #fff;
  font-size: 18px; font-weight: 700; letter-spacing: .3px; cursor: pointer;
  transition: transform .15s, box-shadow .15s, opacity .2s;
}
.claim:hover:not(:disabled) { transform: translateY(-1px); box-shadow: 0 10px 22px rgba(138, 75, 20, .35); }
.claim:disabled { opacity: .45; cursor: not-allowed; }

@media (max-width: 600px) {
  .main { padding: 40px 16px 140px; }
  h1 { font-size: 26px; }
  .coupon-input { font-size: 24px; padding: 22px 14px; letter-spacing: 2px; }
  .bottombar { padding-left: 16px; padding-right: 16px; }
}

/* ---------- Door photo ---------- */
.door-photo {
  margin-top: 28px; padding: 20px; border-radius: 18px; text-align: center;
  background: #fff; border: 1.5px solid #eadfce; box-shadow: 0 8px 24px rgba(90, 52, 22, .08);
}
.door-photo h2 { margin: 0; font-size: 20px; color: #5a3416; }
.photo-hint { margin: 4px 0 16px; color: #7a6a5a; font-size: 14px; }

.door-frame {
  width: 100%; aspect-ratio: 4 / 3; max-height: 320px; margin-bottom: 16px;
  border: 2px dashed #dccfbf; border-radius: 14px; overflow: hidden; background: #faf7f2;
  display: flex; align-items: center; justify-content: center; color: #9a8a79; font-size: 14px;
}
.door-frame.has-photo { border: 2px solid #b9722d; background: #000; }
.door-frame img { width: 100%; height: 100%; object-fit: contain; }

.door-buttons { display: flex; align-items: center; justify-content: center; flex-wrap: wrap; gap: 10px 12px; }
.photo-btn {
  padding: 11px 20px; border-radius: 12px; border: 1.5px solid #b9722d; background: #fff;
  color: #8a4b14; font-weight: 700; font-size: 15px; cursor: pointer; transition: background .2s;
}
.photo-btn:hover { background: #fbf1e5; }
.link-btn { border: none; background: none; color: #d64545; font-weight: 600; font-size: 14px; cursor: pointer; padding: 0; }
.link-btn:hover { text-decoration: underline; }
.photo-error { display: block; margin-top: 12px; color: #d64545; font-size: 13px; }

/* "Take photo" only appears on touch devices (phones and tablets) */
.camera-btn { display: none; }
@media (pointer: coarse) { .camera-btn { display: inline-block; } }
